# Puerto (Render lo define automáticamente, no hace falta tocarlo)
PORT=3000

# Credenciales del administrador (se crean automáticamente la primera vez que arranca el server)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar los tokens de sesión del panel admin
JWT_SECRET=una-clave-larga-y-aleatoria

# Ruta del archivo SQLite (dejar por defecto salvo que uses un Persistent Disk en Render)
DB_PATH=./sneosmart5.db

NODE_ENV=production
